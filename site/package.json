{
  "name": "klarow-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build && npm run prerender",
    "prerender": "node node_modules/vite/bin/vite.js build --ssr src/prerender/entry.tsx --outDir dist-ssr --emptyOutDir && node scripts/prerender.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "lint": "node node_modules/eslint/bin/eslint.js src",
    "test": "node --test \"src/lib/*.test.mjs\"",
    "check": "npm run lint && npm run test && node node_modules/typescript/bin/tsc --noEmit && npm run build && node ../.claude/skills/klarow-guardian/scripts/verify-site.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.525.0",
    "motion": "13.2.0",
    "pdfmake": "^0.3.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0"
  }
}
