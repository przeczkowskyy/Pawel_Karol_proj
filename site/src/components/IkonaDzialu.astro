---
// Sześć ikon na wspólnej siatce 24×24: ta sama obudowa, ten sam bursztynowy punkt
// w tym samym miejscu, ta sama grubość linii. Różni się wyłącznie piktogram.
interface Props {
  slug: "magazyn" | "ksiegowosc" | "integracje" | "czat-ai" | "generatory" | "raporty";
  klasa?: string;
  rozmiar?: number;
}
const { slug, klasa, rozmiar = 40 } = Astro.props;
---

<svg
  class:list={["ikona", klasa]}
  viewBox="0 0 24 24"
  width={rozmiar}
  height={rozmiar}
  aria-hidden="true"
  focusable="false"
>
  <rect class="ikona__obudowa" x="1.5" y="1.5" width="21" height="21" rx="5"></rect>
  <circle class="ikona__punkt" cx="19" cy="5" r="1.25"></circle>
  <g class="ikona__rys">
    {slug === "magazyn" && (
      <>
        <path d="M6.75 15H17.25"></path>
        <rect x="6.75" y="11.25" width="3.75" height="3.75" rx="0.5"></rect>
        <rect x="13.5" y="11.25" width="3.75" height="3.75" rx="0.5"></rect>
        <rect x="10.125" y="7.5" width="3.75" height="3.75" rx="0.5"></rect>
      </>
    )}
    {slug === "ksiegowosc" && (
      <>
        <rect x="6.75" y="13.5" width="10.5" height="3" rx="1.5"></rect>
        <path d="M9 13.5V6.75H15V13.5"></path>
        <path d="M10.875 9.75H13.125"></path>
      </>
    )}
    {slug === "integracje" && (
      <>
        <rect x="6.75" y="9" width="3" height="6" rx="1"></rect>
        <rect x="14.25" y="9" width="3" height="6" rx="1"></rect>
        <path d="M9.75 12H14.25"></path>
        <path d="M8.25 9V6.75M15.75 15V17.25"></path>
      </>
    )}
    {slug === "czat-ai" && (
      <>
        <rect x="6.75" y="7.5" width="10.5" height="7.5" rx="2"></rect>
        <path d="M9.75 15V17.25L12.375 15"></path>
        <circle class="ikona__kropka" cx="9.375" cy="11.25" r=".8"></circle>
        <circle class="ikona__kropka" cx="12" cy="11.25" r=".8"></circle>
        <circle class="ikona__kropka" cx="14.625" cy="11.25" r=".8"></circle>
      </>
    )}
    {slug === "generatory" && (
      <>
        <path d="M7.5 7.5H13.5L16.5 10.5V16.5H7.5Z"></path>
        <path d="M13.5 7.5V10.5H16.5"></path>
        <path d="M9.75 10.125H12"></path>
        <circle cx="12.75" cy="13.5" r="1"></circle>
      </>
    )}
    {slug === "raporty" && (
      <>
        <rect x="6.375" y="12" width="1.5" height="3.75" rx="0.4"></rect>
        <rect x="10.875" y="7.5" width="1.5" height="8.25" rx="0.4"></rect>
        <rect x="15.375" y="9.75" width="1.5" height="6" rx="0.4"></rect>
      </>
    )}
  </g>
</svg>
