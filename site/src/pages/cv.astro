---
import Baza from "../layouts/Baza.astro";
import IkonaDzialu from "../components/IkonaDzialu.astro";
import { kontakt } from "../content/strona";
import { grupyCv, zasadyCv } from "../content/cv";

const opis =
  "Karol Balucki: lista narzędzi, które zbudowałem — kontroling, finanse, importy danych, produkcja i dokumenty.";
---

{/* noindex do czasu akceptacji treści przez Karola: strona działa z linku, ale nie wchodzi do wyszukiwarek. */}
<Baza
  tytul="Karol Balucki — co zbudowałem | Klarow"
  opis={opis}
  sciezka="/cv"
  wariantTla="przyklady"
  krotkaStopka={true}
  noindex={true}
>
  <main class="przyklady cv">
    <div class="przyklady__wstep">
      <nav class="dzial__sciezka" aria-label="Ścieżka">
        <a href="/">Strona główna</a> › CV
      </nav>
      <p class="etykieta">CV · KAROL BALUCKI</p>
      <h1 class="przyklady__tytul">Co zbudowałem</h1>
      <div class="cv__osoba">
        <div class="osoba">
          <div class="osoba__dane">
            <p class="osoba__imie">{kontakt.osoba}</p>
            <p class="osoba__rola">automatyzacje, integracje, raporty</p>
          </div>
          <p class="narzedzie__wewy">{kontakt.telefon} · {kontakt.mail}</p>
        </div>
      </div>
      <div class="przyklady__akcje">
        <a class="przycisk przycisk--glowny" href={kontakt.telefonHref}>
          <span set:html={`Zadzwońcie ${kontakt.telefon}`} />
        </a>
        <a class="przycisk przycisk--wysoki" href={kontakt.vcard}>Zapisz w&nbsp;kontaktach</a>
      </div>
      <p class="przyklad__etykieta">Bez nazw firm i&nbsp;bez liczb z&nbsp;cudzych danych.</p>
    </div>

    <div class="przyklady__siatka">
      {
        grupyCv.map((g) => (
          <section class="przyklad" aria-labelledby={`h-${g.slug}`}>
            <div class="przyklad__naglowek">
              <IkonaDzialu slug={g.ikona} klasa="przyklad__ikona" />
              <h2 id={`h-${g.slug}`} class="przyklad__tytul">
                {g.tytul}
              </h2>
            </div>
            <ul class="przyklad__lista">
              {g.narzedzia.map((n) => (
                <li class="przyklad__pozycja narzedzie">
                  <h3 class="narzedzie__nazwa">{n.nazwa}</h3>
                  <p class="narzedzie__opis">{n.robi}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <section class="przyklad cv__szeroki" aria-labelledby="h-zasady">
      <div class="przyklad__naglowek">
        <h2 id="h-zasady" class="przyklad__tytul">Jak to buduję</h2>
      </div>
      <ul class="przyklad__lista">
        {zasadyCv.map((z) => <li class="przyklad__pozycja">{z}</li>)}
      </ul>
    </section>

    <div class="przyklady__koniec">
      <div class="przyklady__akcje">
        <a class="przycisk przycisk--glowny" href={kontakt.telefonHref}>
          <span set:html={`Zadzwońcie ${kontakt.telefon}`} />
        </a>
        <a class="przycisk przycisk--wysoki" href={kontakt.mailExcel}>Przyślijcie plik, który Was męczy</a>
      </div>
      <p class="sasiedzi">
        <a class="link przyklady__powrot" href="/">← Co robię dla firm</a>
      </p>
    </div>
  </main>
</Baza>
