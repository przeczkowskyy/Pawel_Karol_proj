---
import Baza from "../layouts/Baza.astro";
import IkonaDzialu from "../components/IkonaDzialu.astro";
import { kontakt, haslo } from "../content/strona";
import { grupyCv, zasadyCv, jakPracuje } from "../content/cv";

const opis =
  "Karol Balucki: narzędzia, które zbudowałem — kontroling, finanse, importy danych, produkcja i dokumenty. Co robią, co zastępują i co z nich wychodzi.";
---

{/* noindex do czasu akceptacji treści przez Karola: strona działa z linku, ale nie wchodzi do wyszukiwarek. */}
<Baza
  tytul="Karol Balucki — narzędzia, które zbudowałem | Klarow"
  opis={opis}
  sciezka="/cv"
  wariantTla="przyklady"
  krotkaStopka={true}
  noindex={true}
>
  <main class="przyklady cv">
    <div class="przyklady__wstep">
      <nav class="dzial__sciezka" aria-label="Ścieżka">
        <a href="/">Strona główna</a> › CV
      </nav>
      <p class="etykieta">CV · KAROL BALUCKI</p>
      <h1 class="przyklady__tytul">Narzędzia, które zbudowałem</h1>
      <p class="karta-tekstu przyklady__lead">
        Klarow to jedna osoba. Piszę kod, wdrażam go u&nbsp;Was i&nbsp;odbieram telefon. Niżej trzynaście
        narzędzi, które zrobiłem: co robią, co zastępują i&nbsp;co z&nbsp;nich wychodzi.
      </p>
      <div class="cv__osoba">
        <div class="osoba">
          <div class="osoba__dane">
            <p class="osoba__imie">{kontakt.osoba}</p>
            <p class="osoba__rola">automatyzacje, integracje, raporty</p>
          </div>
          <p class="narzedzie__wewy">{kontakt.telefon} · {kontakt.mail}</p>
        </div>
      </div>
      <p class="przyklad__etykieta">
        Bez nazw firm i&nbsp;bez liczb z&nbsp;cudzych danych. Opisuję mechanizm, nie czyjeś wyniki. U&nbsp;Was
        to samo narzędzie wygląda inaczej, bo układa się pod Wasz proces.
      </p>
      <div class="przyklady__akcje">
        <a class="przycisk przycisk--glowny" href={kontakt.telefonHref}>
          <span set:html={`Zadzwońcie ${kontakt.telefon}`} />
        </a>
        <a class="przycisk przycisk--wysoki" href={kontakt.vcard}>Zapisz w&nbsp;kontaktach</a>
      </div>
    </div>

    <div class="przyklady__siatka">
      {
        grupyCv.map((g) => (
          <section class="przyklad" aria-labelledby={`h-${g.slug}`}>
            <div class="przyklad__naglowek">
              <IkonaDzialu slug={g.ikona} klasa="przyklad__ikona" />
              <h2 id={`h-${g.slug}`} class="przyklad__tytul">
                {g.tytul}
              </h2>
            </div>
            <ul class="przyklad__lista">
              {g.narzedzia.map((n) => (
                <li class="przyklad__pozycja narzedzie">
                  <h3 class="narzedzie__nazwa">{n.nazwa}</h3>
                  <p class="narzedzie__opis">{n.robi}</p>
                  <p class="narzedzie__zamiast">
                    <span class="narzedzie__slowo">zamiast</span> {n.zamiast}
                  </p>
                  <p class="narzedzie__wewy">{n.weWy}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <section class="przyklad cv__szeroki" aria-labelledby="h-zasady">
      <div class="przyklad__naglowek">
        <h2 id="h-zasady" class="przyklad__tytul">Na czym mi zależy, kiedy to buduję</h2>
      </div>
      <div class="cv__zasady">
        {
          zasadyCv.map((z) => (
            <div class="cv__zasada">
              <h3 class="narzedzie__nazwa">{z.tytul}</h3>
              <p class="narzedzie__opis">{z.opis}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="przyklad cv__szeroki" aria-labelledby="h-jak">
      <div class="przyklad__naglowek">
        <h2 id="h-jak" class="przyklad__tytul">Jak pracuję</h2>
      </div>
      <ol class="kroki">
        {
          jakPracuje.map((k, i) => (
            <li class="krok">
              <span class="krok__numer" aria-hidden="true">
                {i + 1}
              </span>
              <div class="krok__tresc">
                <h3 class="krok__tytul">{k.tytul}</h3>
                <p class="krok__opis">{k.opis}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="przyklady__koniec">
      <p class="haslo">{haslo}</p>
      <p class="karta-tekstu przyklady__lead">
        Jeśli któreś z&nbsp;tych narzędzi przypomina Wasz problem, to najkrótsza droga jest przez telefon.
      </p>
      <div class="przyklady__akcje">
        <a class="przycisk przycisk--glowny" href={kontakt.telefonHref}>
          <span set:html={`Zadzwońcie ${kontakt.telefon}`} />
        </a>
        <a class="przycisk przycisk--wysoki" href={kontakt.mailExcel}>Przyślijcie plik, który Was męczy</a>
      </div>
      <p class="sasiedzi">
        <a class="link przyklady__powrot" href="/">← Co robię dla firm</a>
      </p>
    </div>
  </main>
</Baza>
