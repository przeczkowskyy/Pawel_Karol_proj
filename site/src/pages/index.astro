---
import Baza from "../layouts/Baza.astro";
import StronaGlowna from "../components/StronaGlowna.astro";
import { daneStrukturalne } from "../content/strona";

const opis =
  "Automatyzujemy to, co ktoś u Was dziś przepisuje ręcznie: magazyn, księgowość, Excel, dokumenty i raporty. Policzcie, ile kosztuje ręczna robota.";
---

<Baza tytul="Klarow — automatyzacje, integracje i raporty" opis={opis} sciezka="/" doGory={true} schema={daneStrukturalne}>
  <StronaGlowna />
</Baza>
